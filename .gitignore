.pytest_cache/
*.egg-info/
.venv/
dist/
build/
__pycache__/
*.py[cod]

# Editor
.vscode/
.idea/
.DS_Store

# Generated by a run. Importing rahpo creates output/ next to the repository.
# The older root folders stay ignored so a previous run is not committed.
# The leading slash keeps a directory rule at the repository root, so docs/images/ is unaffected.
/output/
/planes/
/npz_data/
/images/
/logs/
/figures/
/metrics/

# Plots, documents, and binary products. The repository is the code that
# regenerates them. Two inputs of the worked example, and the pictures
# embedded in the README, are the exceptions below.
*.png
*.pdf
*.gif
*.npz
*.npy
*.h5
*.out
*.vti
*.vtk
*.vtkhdf

# gprMax writes a materials list next to a generated geometry volume
examples/gprMax_models/**/input_h5_geom/*.txt

# Outputs of an older validate_propagation.py, written to the working directory
propagation_*.npz

# Kept on purpose
!examples/example_plane.h5
!examples/example_reference.npz
!docs/images/*.png
